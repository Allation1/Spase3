@echo off
REM Повністю вимикаємо відображення команд та коментарів у консолі
chcp 65001 >nul
REM Встановлюємо кодування UTF-8, щоб українські літери працювали без помилок
cd /d "%~dp0"
REM Переходимо в папку, де лежить цей bat-файл та наш index.js
node index.js
REM Запускаємо сервер, передаючи файл index.js
pause
REM Ставимо паузу, щоб вікно не закрилося при помилці